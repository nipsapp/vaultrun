# Vault Run Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# JWT / sessions
JWT_SECRET=change-me-vault-run-dev-secret-32chars
JWT_EXPIRES=12h
SESSION_TTL_HOURS=12

# Wallet
STARTING_BALANCE=10000
CURRENCY=USD
MIN_BET=0.2
MAX_BET=100

# RNG: crypto (dev/demo CSPRNG) | external (certified provider hook)
RNG_MODE=crypto
# RNG_EXTERNAL_URL=
# RNG_EXTERNAL_KEY=

# RGS / Stake Engine
RGS_MODE=local
# local = this server is the authority
# stake = forward wallet to Stake Engine / operator RGS
# STAKE_ENGINE_BASE_URL=https://api.example-stake-engine.com
# STAKE_ENGINE_API_KEY=
# STAKE_ENGINE_GAME_ID=vault-run
# STAKE_ENGINE_OPERATOR_ID=

# CORS (comma-separated origins; * for dev)
CORS_ORIGIN=*

# Database file
DATABASE_PATH=./data/vaultrun.sqlite
