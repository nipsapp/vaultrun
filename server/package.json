{
  "name": "vaultrun-server",
  "version": "1.0.0",
  "description": "Vault Run game server — wallet, sessions, RNG-agnostic resolve, RGS adapter",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/db/migrate.js && node src/index.js",
    "dev": "node --watch src/index.js",
